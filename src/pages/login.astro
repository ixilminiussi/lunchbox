---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUser } from '../lib/session';

const { SESSION_SECRET, IXIL_PASSWORD, MATHILDE_PASSWORD } = Astro.locals.runtime.env;
const env = { SESSION_SECRET, IXIL_PASSWORD, MATHILDE_PASSWORD };
const user = await getUser(Astro.request, env);
if (user) return Astro.redirect('/');

const error = Astro.url.searchParams.has('error');
---

<BaseLayout title="Login — Lunchbox">
  <h1 class="page-heading">Login</h1>
  {error && <p class="login-error">Wrong password. Try again.</p>}
  <div class="login-row">
    <form class="login-card" method="POST" action="/api/auth/login">
      <input type="hidden" name="username" value="Ixil" />
      <h2 class="author-ixil">Ixil</h2>
      <input type="password" name="password" placeholder="Password" class="search-input" required />
      <button type="submit" class="manage-btn">Login</button>
    </form>
    <form class="login-card" method="POST" action="/api/auth/login">
      <input type="hidden" name="username" value="Mathilde" />
      <h2 class="author-mathilde">Mathilde</h2>
      <input type="password" name="password" placeholder="Password" class="search-input" required />
      <button type="submit" class="manage-btn">Login</button>
    </form>
  </div>
</BaseLayout>
