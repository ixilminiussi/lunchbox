---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterIsland from '../components/FilterIsland.tsx';
import { getAllRecipes } from '../lib/recipes';
import { inferDietary, normalise } from '../lib/dietary';
import { getUser } from '../lib/session';

const { RECIPES: kv, SESSION_SECRET, IXIL_PASSWORD, MATHILDE_PASSWORD } = Astro.locals.runtime.env;
const env = { SESSION_SECRET, IXIL_PASSWORD, MATHILDE_PASSWORD };
const currentUser = await getUser(Astro.request, env);

const recipes = await getAllRecipes(kv);
const recipesData = recipes.map((r) => ({
  id: r.id,
  title: r.data.title,
  image: r.data.image,
  prep_time: r.data.prep_time,
  cook_time: r.data.cook_time,
  difficulty: r.data.difficulty,
  cuisine: r.data.cuisine ?? '',
  meal_type: r.data.meal_type,
  tags: r.data.tags,
  added_by: r.data.added_by,
  dietary: inferDietary(r.data.ingredients),
  ingredients: r.data.ingredients,
  ratings: r.data.ratings ?? {},
}));

// Collect unique values for filters
const cuisines = [...new Set(recipesData.map((r) => r.cuisine).filter(Boolean))].sort();
const mealTypes = [...new Set(recipesData.map((r) => r.meal_type))].sort();
const allTags = [...new Set(recipesData.flatMap((r) => r.tags))].sort();
const allDiets = [...new Set(recipesData.flatMap((r) => r.dietary))].sort();
const authors = [...new Set(recipesData.map((r) => r.added_by))].sort();
const allIngredientNames = [...new Set(recipesData.flatMap((r) => r.ingredients.map(normalise)).filter(Boolean))].sort();
---

<BaseLayout title="Browse — Lunchbox">
  <h1 class="page-heading">Browse recipes</h1>

  {currentUser && (
    <div class="manage-bar">
      <a href="/recipes/new" class="manage-btn">+ Add recipe</a>
      <a href="/recipes/import" class="manage-btn">Import from URL</a>
      <a href="/recipes/import-md" class="manage-btn">Import markdown</a>
      <a href="/api/recipes/export" class="manage-btn">Download all (.zip)</a>
    </div>
  )}

  <FilterIsland
    client:load
    recipes={recipesData}
    cuisines={cuisines}
    mealTypes={mealTypes}
    allTags={allTags}
    allDiets={allDiets}
    authors={authors}
    allIngredientNames={allIngredientNames}
  />
</BaseLayout>
