---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getAllRecipes } from '../../lib/recipes';
import { inferDietary } from '../../lib/dietary';

const { RECIPES: kv } = Astro.locals.runtime.env;
const recipes = await getAllRecipes(kv);
const cards = recipes.slice(0, 6).map((r) => ({
  id: r.id,
  title: r.data.title,
  image: r.data.image,
  prep_time: r.data.prep_time,
  cook_time: r.data.cook_time,
  difficulty: r.data.difficulty,
  dietary: inferDietary(r.data.ingredients),
}));
---

<BaseLayout title="Preview: ASCII Centerpiece">
  <h1 class="page-heading">ASCII Background 2 — Large Centerpiece</h1>
  <p style="color: var(--color-text-light); font-size: 0.85rem; padding: 0.5rem 0 1rem;">
    Single large ASCII art of a steaming pot, centered and fixed behind all content.
  </p>
  <div class="recipe-grid">
    {cards.map((r) => <RecipeCard {...r} />)}
  </div>
</BaseLayout>

<style is:global>
  .ascii-centerpiece {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: -1;
    pointer-events: none;
    opacity: 0.04;
    font-family: 'SF Mono', 'Cascadia Code', 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 14px;
    line-height: 1.2;
    white-space: pre;
    color: var(--color-text);
    user-select: none;
  }
</style>

<pre class="ascii-centerpiece" aria-hidden="true">{`
