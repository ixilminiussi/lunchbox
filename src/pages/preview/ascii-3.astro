---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getAllRecipes } from '../../lib/recipes';
import { inferDietary } from '../../lib/dietary';

const { RECIPES: kv } = Astro.locals.runtime.env;
const recipes = await getAllRecipes(kv);
const cards = recipes.slice(0, 6).map((r) => ({
  id: r.id,
  title: r.data.title,
  image: r.data.image,
  prep_time: r.data.prep_time,
  cook_time: r.data.cook_time,
  difficulty: r.data.difficulty,
  dietary: inferDietary(r.data.ingredients),
}));

// Seeded pseudo-random for stable server renders
function mulberry32(a: number) {
  return function() {
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(42);

const glyphs = [
  '~', '*', '+', '#', '@', '%', '&', '^',
  'c[_]', '(o)', '[=]', '{~}', '<>', '|||',
  '/\\', '\\/', '_.', '.-', '::', '...',
  '>>>',  '<<<', '((o))', '|#|', '[o]',
  '=|=', '-+-', '~^~', 'oOo', '(*)',
  '{{}}', '/|\\', '\\|/', '-=-', '~*~',
  '>.<', ':o:', '[_]', '|=|', '<o>',
];

const items = Array.from({ length: 40 }, () => ({
  glyph: glyphs[Math.floor(rand() * glyphs.length)],
  top: (rand() * 100).toFixed(1),
  left: (rand() * 100).toFixed(1),
  rotation: (rand() * 360 - 180).toFixed(0),
  size: (0.7 + rand() * 1.3).toFixed(2),
}));
---

<BaseLayout title="Preview: Scattered Glyphs">
  <h1 class="page-heading">ASCII Background 3 — Scattered Random Glyphs</h1>
  <p style="color: var(--color-text-light); font-size: 0.85rem; padding: 0.5rem 0 1rem;">
    ~40 randomly positioned food-related characters at varying rotation and size, fixed behind content.
  </p>
  <div class="recipe-grid">
    {cards.map((r) => <RecipeCard {...r} />)}
  </div>
</BaseLayout>

<div class="glyph-field" aria-hidden="true">
  {items.map((item) => (
    <span
      class="glyph-item"
      style={`top:${item.top}%;left:${item.left}%;transform:rotate(${item.rotation}deg);font-size:${item.size}rem;`}
    >
      {item.glyph}
    </span>
  ))}
</div>

<style is:global>
  .glyph-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .glyph-item {
    position: absolute;
    font-family: 'SF Mono', 'Cascadia Code', 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    color: var(--color-text);
    opacity: 0.12;
    white-space: nowrap;
    user-select: none;
    line-height: 1;
  }
</style>
