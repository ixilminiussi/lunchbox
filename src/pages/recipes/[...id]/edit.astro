---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipeForm from '../../../components/RecipeForm.tsx';
import { getUser } from '../../../lib/session';
import { getRecipeById } from '../../../lib/recipes';

const { RECIPES: kv, SESSION_SECRET, IXIL_PASSWORD, MATHILDE_PASSWORD } = Astro.locals.runtime.env;
const env = { SESSION_SECRET, IXIL_PASSWORD, MATHILDE_PASSWORD };
const user = await getUser(Astro.request, env);
if (!user) return Astro.redirect('/login');

const { id } = Astro.params;
if (!id) return Astro.redirect('/browse');

const recipe = await getRecipeById(kv, id);
if (!recipe) return Astro.redirect('/browse');

const d = recipe.data;

// Extract and parse instructions from body into steps array
let rawInstructions = recipe.body.trim();
if (rawInstructions.startsWith('## Instructions')) {
  rawInstructions = rawInstructions.replace(/^## Instructions\s*\n*/, '').trim();
}
const instructionSteps = rawInstructions
  ? rawInstructions.split(/\n*\d+\.\s+/).filter(Boolean).map((s) => s.trim())
  : [];
---

<BaseLayout title={`Edit ${d.title} — Lunchbox`}>
  <h1 class="page-heading">Edit: {d.title}</h1>
  <RecipeForm
    client:only="preact"
    mode="edit"
    recipeId={id}
    initial={{
      title: d.title,
      servings: d.servings,
      prep_time: d.prep_time,
      cook_time: d.cook_time,
      cuisine: d.cuisine ?? '',
      meal_type: d.meal_type,
      difficulty: d.difficulty,
      tags: d.tags,
      added_by: d.added_by,
      source: d.source ?? '',
      image: d.image ?? '',
      ingredients: d.ingredients,
      instructions: instructionSteps,
    }}
  />
</BaseLayout>
