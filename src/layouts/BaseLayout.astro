---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.tsx';

interface Props {
  title?: string;
  currentUser?: string | null;
}

const { title = 'Lunchbox', currentUser = null } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function() {
        const t = localStorage.getItem('lunchbox-theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.setAttribute('data-theme', t);
        } else {
          document.documentElement.setAttribute('data-theme',
            window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        }
      })();
    </script>
  </head>
  <body>
    <nav class="nav">
      <div class="container">
        <a href="/" class="nav-logo">lunchbox</a>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/browse">Browse</a></li>
          {currentUser ? (
            <li class="nav-user">
              <span class={currentUser.toLowerCase() === 'mathilde' ? 'author-mathilde' : 'author-ixil'}>
                {currentUser}
              </span>
              <form method="POST" action="/api/auth/logout" style="display:inline;">
                <button type="submit" class="nav-logout-btn">[logout]</button>
              </form>
            </li>
          ) : (
            <li><a href="/login">[login]</a></li>
          )}
          <li><ThemeToggle client:load /></li>
        </ul>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">&mdash;</div>
    </footer>
  </body>
</html>
